to","url":"https://pbs.twimg.com/media/HOn17IQWgAAYc94?format=jpg&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HOn3MsxXcAAf5R4?format=jpg&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HOwEMUNXQAApZzX?format=jpg&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HOwHyblWIAAwvrv?format=jpg&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HOwIbsdWcAA5LDo?format=jpg&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HOwKQ0BX0AABNFN?format=jpg&name=large"}],"stats":{},"category":"","isThread":true},{"tweetId":"2075582767698690513","sourceUrl":"https://x.com/CFlanders7/status/2075582767698690513","capturedAt":"2026-10-10T09:20:59.161984+00:00","createdAt":"Jul 10","fullText":"I had a pretty good idea that the top 10 trades made my entire year. I went back to my data to see just how close it was.\n\nTop 10 trades = 127 risk adjusted R\nTotal risk adjusted R return for 2025: 129\n\nSo yeah, remove the top 10 trades and I am break even.","author":{"handle":"@CFlanders7","name":"(@CFlanders7)"},"media":[],"stats":{},"category":"","isThread":false}]},{"tweetId":"2094387309449723997","sourceUrl":"https://x.com/Muninn/status/2094387309449723997/analytics","capturedAt":"2026-10-10T09:20:54.055984+00:00","createdAt":"238K","fullText":"Everything I’ve Learned About Position Sizing From a Market Wizard","author":{"handle":"@Muninn","name":"James Muninn (@Muninn)"},"media":[{"type":"photo","url":"https://pbs.twimg.com/media/HQhAq4uWIAAmPjA?format=jpg&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HPqXrczXMAAmAyE?format=jpg&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HQ_1jNKWYAAnZ5C?format=png&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HOnpUnfWcAA93Kn?format=png&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HQ_8iZMXIAA2RWg?format=png&name=large"},{"type":"photo","url":"https://pbs.twimg.com/media/HQ_9IsXWwAA17gr?format=png&name=large